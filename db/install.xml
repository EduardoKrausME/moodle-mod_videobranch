<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/videobranch/db" VERSION="20260920" COMMENT="XMLDB file for Moodle mod_videobranch"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="videobranch" COMMENT="Branching Video activity instances">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="resumeplayback" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="allowseek" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="allowback" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="showpath" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="completionending" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="videobranch_videos" COMMENT="Videos used by a Branching Video activity">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videobranchid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="sourcetype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="url" SEQUENCE="false"/>
                <FIELD NAME="sourceurl" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="isstart" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videobranchid" REFTABLE="videobranch" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity_start" UNIQUE="false" FIELDS="videobranchid,isstart"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videobranch_nodes" COMMENT="Decision nodes attached to video timecodes">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videobranchid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="videoid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="question" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="triggersecond" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videobranchid" REFTABLE="videobranch" REFFIELDS="id"/>
                <KEY NAME="video" TYPE="foreign" FIELDS="videoid" REFTABLE="videobranch_videos" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="video_time" UNIQUE="false" FIELDS="videoid,triggersecond"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videobranch_endings" COMMENT="Named valid endings">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videobranchid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videobranchid" REFTABLE="videobranch" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="videobranch_options" COMMENT="Alternatives belonging to decision nodes">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="nodeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="label" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="targettype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="time" SEQUENCE="false"/>
                <FIELD NAME="targetvideoid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="targetsecond" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="targetnodeid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="targetendingid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="node" TYPE="foreign" FIELDS="nodeid" REFTABLE="videobranch_nodes" REFFIELDS="id"/>
                <KEY NAME="targetvideo" TYPE="foreign" FIELDS="targetvideoid" REFTABLE="videobranch_videos"
                     REFFIELDS="id"/>
                <KEY NAME="targetnode" TYPE="foreign" FIELDS="targetnodeid" REFTABLE="videobranch_nodes"
                     REFFIELDS="id"/>
                <KEY NAME="targetending" TYPE="foreign" FIELDS="targetendingid" REFTABLE="videobranch_endings"
                     REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="node_sort" UNIQUE="false" FIELDS="nodeid,sortorder"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videobranch_attempts" COMMENT="Current learner path and resume state">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videobranchid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="currentvideoid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="currentposition" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="watchedjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="pathjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="endingid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="completed" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videobranchid" REFTABLE="videobranch" REFFIELDS="id"/>
                <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="currentvideo" TYPE="foreign" FIELDS="currentvideoid" REFTABLE="videobranch_videos"
                     REFFIELDS="id"/>
                <KEY NAME="ending" TYPE="foreign" FIELDS="endingid" REFTABLE="videobranch_endings" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity_user" UNIQUE="true" FIELDS="videobranchid,userid"/>
                <INDEX NAME="completed" UNIQUE="false" FIELDS="videobranchid,completed"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videobranch_choices" COMMENT="Decision history for learner attempts">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="nodeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="optionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="sequence" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="active" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="fromvideoid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="fromposition" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="attempt" TYPE="foreign" FIELDS="attemptid" REFTABLE="videobranch_attempts" REFFIELDS="id"/>
                <KEY NAME="node" TYPE="foreign" FIELDS="nodeid" REFTABLE="videobranch_nodes" REFFIELDS="id"/>
                <KEY NAME="option" TYPE="foreign" FIELDS="optionid" REFTABLE="videobranch_options" REFFIELDS="id"/>
                <KEY NAME="fromvideo" TYPE="foreign" FIELDS="fromvideoid" REFTABLE="videobranch_videos" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="attempt_sequence" UNIQUE="false" FIELDS="attemptid,sequence"/>
                <INDEX NAME="attempt_active" UNIQUE="false" FIELDS="attemptid,active"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
