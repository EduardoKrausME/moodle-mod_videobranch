{{!
    @template mod_videobranch/ending
    @package mod_videobranch
}}
<div class="videobranch-ending" role="status">
    <div class="videobranch-ending-icon" aria-hidden="true">✓</div>
    <h3>{{#str}}endingreached, videobranch{{/str}}: {{name}}</h3>
    {{#message}}
        <div class="videobranch-ending-message">{{{message}}}</div>{{/message}}
    {{#showpath}}<p>{{#str}}pathavailablebelow, videobranch{{/str}}</p>{{/showpath}}
</div>
