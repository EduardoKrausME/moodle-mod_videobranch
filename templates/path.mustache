{{!
    @template mod_videobranch/path
    @package mod_videobranch
}}
{{^path}}
    <p class="text-muted">{{#str}}nopathyet, videobranch{{/str}}</p>
{{/path}}
{{#path}}
    <ol class="videobranch-path-list">
        {{#path}}
            <li>
                <div class="videobranch-path-question">{{nodename}}</div>
                <div>{{optionlabel}}</div>
                {{#allowback}}
                    <button type="button" class="btn btn-link btn-sm p-0" data-action="rewind"
                            data-choiceid="{{choiceid}}">{{#str}}changedecision, videobranch{{/str}}</button>
                {{/allowback}}
            </li>
        {{/path}}
    </ol>
{{/path}}
